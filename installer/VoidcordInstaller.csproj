<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>voidicon.ico</ApplicationIcon>
    <AssemblyName>VoidcordInstaller</AssemblyName>
    <RootNamespace>VoidcordInstallerApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\voidcord.js" Link="voidcord_payload" LogicalName="voidcord_payload" />
    <EmbeddedResource Include="..\voidicon.png" Link="voidicon_image" LogicalName="voidicon_image" />
    <EmbeddedResource Include="midnight.theme.css" Link="midnight_theme_payload" LogicalName="midnight_theme_payload" />
  </ItemGroup>
</Project>
